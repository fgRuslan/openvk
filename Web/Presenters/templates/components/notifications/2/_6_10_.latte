{var $comment = $notification->getModel(0)}
{var $user = $comment->getOwner()}
{var $note = $notification->getModel(1)}

<a href="{$user->getURL()}"><b>{$user->getCanonicalName()}</b></a>
{_nt_commented_yours} {_nt_yours_feminitive_adjective} <a href="/note{$note->getPrettyId()}">{_nt_note_instrumental}</a>: "{$notification->getData()}".
<div class="nobold">
    {$notification->getDateTime()}
</div>
